{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RustlingPDF",
  "mainBinaryName": "RustlingPDF",
  "version": "0.0.8",
  "identifier": "io.github.hairbui76.rustlingpdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --mode core",
    "beforeBuildCommand": "npx vite build --mode core"
  },
  "app": {
    "windows": [
      {
        "title": "RustlingPDF",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--enable-features=CertVerifierBuiltinFeature"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "RustlingPDF contributors",
    "targets": ["deb", "rpm", "appimage", "dmg", "app", "msi", "nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/192x192.png"
    ],
    "externalBin": ["binaries/rustling-processing"],
    "resources": ["resources/pdfium", "resources/tools"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "rustlingpdf.desktop"
      },
      "rpm": {
        "desktopTemplate": "rustlingpdf.desktop",
        "compression": {
          "type": "zstd",
          "level": 3
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "template": "windows/wix/main.wxs",
        "upgradeCode": "92156D31-4DBC-43C0-8717-C60CF63C435C",
        "bannerPath": "windows/wix/banner.bmp",
        "dialogImagePath": "windows/wix/dialog.bmp",
        "fragmentPaths": ["windows/wix/provisioning.wxs"],
        "componentGroupRefs": ["ProvisioningComponentGroup"]
      },
      "nsis": {
        "compression": "lzma",
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null,
      "providerShortName": null,
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBREEyREM4RkM0RkFGMEIKUldRTHIwLzh5QzNhbXVWNUdEUjhtOUFWbHRJZTYrQ3pyMHVHbG9xKzNxNGFMZmxtSFh2S0Y5SmQK",
      "endpoints": [
        "https://github.com/hairbui76/RustlingPDF/releases/latest/download/latest.json"
      ]
    }
  }
}
