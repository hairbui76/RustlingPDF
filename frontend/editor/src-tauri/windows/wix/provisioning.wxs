<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="STIRLING_SERVER_URL" Secure="yes" />
    <Property Id="STIRLING_LOCK_CONNECTION" Secure="yes" />
    <!-- STIRLING_LOGIN_AGREEMENT — "1"/"true" enables the login agreement popup on this install. -->
    <Property Id="STIRLING_LOGIN_AGREEMENT" Secure="yes" />
    <!--
      STIRLING_UPDATE_MODE — headless auto-update policy for MDM/Intune deploys.
      Accepts "prompt" (default, user-interactive), "auto" (silent download+install on
      startup), or "disabled" (never check). Leaving it unset preserves whatever was
      configured on the previous install (or defaults to "prompt" on a fresh install).
    -->
    <Property Id="STIRLING_UPDATE_MODE" Secure="yes" />

    <DirectoryRef Id="TARGETDIR">
      <Directory Id="AppDataFolder" />
      <Directory Id="CommonAppDataFolder" />
    </DirectoryRef>

    <!--
      Uninstall cleanup policy for everything this fragment authors
      (rust/contracts/desktop-windows-installer.md is the contract):

      - MSI on its own only removes the registry *values* a component wrote; the
        key skeletons survive. Every key this fragment creates therefore carries
        ForceDeleteOnUninstall="yes", which emits a Registry-table row with
        Name="-" — "delete this key and all its subkeys when the component is
        removed".
      - ForceDeleteOnUninstall is applied ONLY to leaf nodes this product itself
        writes. Shared parents (SOFTWARE\Classes\CLSID,
        SOFTWARE\Classes\.pdf, SOFTWARE\Classes\.pdf\shellex,
        SOFTWARE\Classes\SystemFileAssociations\.pdf\shell) are never marked:
        force-deleting a key takes its whole subtree with it, and those subtrees
        hold other applications' registrations. The cost of that restraint is a
        possibly-empty `.pdf\shellex` key left behind when RustlingPDF was the
        first shell-extension handler ever registered for .pdf — MSI has no
        "delete only if empty" primitive, and leaking an empty key is strictly
        better than deleting another PDF viewer's thumbnail/preview handlers.
      - "Writes" is not the same as "owns outright", and exactly one of these
        nodes is not exclusively ours: `.pdf\shellex\{E357FCCD-…}` is a
        *rendezvous slot* — see the note on ThumbnailHandlerShellexComponent
        below for who can end up owning it and what our uninstall then does.
      - Major upgrades are safe: the bundler's main.wxs schedules
        <MajorUpgrade Schedule="afterInstallInitialize"/>, so the old product is
        fully removed (running these deletions) *before* the new product writes
        its own copies of the same keys.
    -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="ProvisionerBinaryComponent" Guid="*">
        <File Id="ProvisionerExe" Source="$(sys.SOURCEFILEDIR)stirling-provision.exe" KeyPath="yes" />
        <!--
          Cleanup for a key the *bundler template* authors and forgets: main.wxs
          stores InstallDir / "Desktop Shortcut" / "Start Menu Shortcut" /
          "Uninstaller Shortcut" under HKCU\Software\<Manufacturer>\<ProductName>
          and only ever removes those values, leaving the key behind. A wix
          fragment is the only hook we have into that template, so the removal is
          attached here (this component is always installed — the External
          feature is Absent="disallow").

          The names are spelled literally, NOT as {{manufacturer}} /
          {{product_name}}: tauri-bundler renders main.wxs through Handlebars but
          hands fragment files to candle unrendered (tauri-bundler 2.9.4,
          bundle/windows/msi/mod.rs — the rendered fragment string is used only
          to sniff xmlns extensions). Manufacturer is bundle.publisher and
          product name is productName, both "RustlingPDF" in tauri.conf.json;
          if either changes, this key must change with it.

          Only the product key is removed. The manufacturer key
          HKCU\Software\RustlingPDF is left in place: it is a shared namespace by
          convention, and MSI cannot express "delete only if empty".
        -->
        <RemoveRegistryKey Id="RemoveTemplateProductKey" Root="HKCU" Key="Software\RustlingPDF\RustlingPDF" Action="removeOnUninstall" />
      </Component>
      <Component Id="ThumbnailHandlerDllComponent" Guid="*">
        <File Id="ThumbnailHandlerDll" Source="$(sys.SOURCEFILEDIR)stirling_thumbnail_handler.dll" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- PDF Thumbnail Handler COM registration -->
    <DirectoryRef Id="TARGETDIR">
      <Component Id="ThumbnailHandlerClsidComponent" Guid="*">
        <!--
          {2D2FBE3A-…} is this product's own COM class id, so the whole GUID
          subtree (including InprocServer32, whose value points at
          [INSTALLDIR]stirling_thumbnail_handler.dll and would otherwise survive
          the DLL it names) belongs to us and is force-deleted. The shared
          SOFTWARE\Classes\CLSID parent is deliberately left alone.

          InprocServer32 carries the attribute too, which is redundant — the
          parent's Name="-" row already takes it — but keeps each authored key
          paired with its own removal instruction, so splitting or reordering
          these elements later cannot silently orphan one. Deleting an already
          deleted key is a no-op for MSI.
        -->
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{2D2FBE3A-9A88-4308-A52E-7EF63CA7CF48}" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="RustlingPDF Thumbnail Handler" KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{2D2FBE3A-9A88-4308-A52E-7EF63CA7CF48}\InprocServer32" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="[INSTALLDIR]stirling_thumbnail_handler.dll" />
          <RegistryValue Type="string" Name="ThreadingModel" Value="Apartment" />
        </RegistryKey>
      </Component>
      <Component Id="ThumbnailHandlerShellexComponent" Guid="*">
        <!--
          {E357FCCD-…} is IThumbnailProvider's interface id: a *rendezvous slot*,
          not a node this product owns. There is exactly one such key per file
          extension, and its default value names whichever handler currently
          serves .pdf thumbnails — so ownership is by succession, last writer
          wins. Installing RustlingPDF overwrites whatever was there; another PDF
          application installing later overwrites us.

          The consequence, stated plainly: if another application claims the slot
          after we install, our uninstall force-deletes the key and takes *that
          application's* registration with it, leaving .pdf thumbnails dead until
          it is repaired or reinstalled.

          This is accepted rather than fixed. MSI's plain value-removal is no
          safer — it deletes the key's default value whether or not someone else
          overwrote it — so the alternative buys nothing but a leftover empty
          key, and last-writer-wins is how every shell-extension handler on
          Windows behaves. MSI cannot express "delete only if the value is still
          mine". Force-deletion is scoped to this single GUID node; the enclosing
          SOFTWARE\Classes\.pdf\shellex, shared with every other .pdf shell
          extension (preview handlers, property handlers, other viewers'
          thumbnail providers), is never touched.
        -->
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.pdf\shellex\{E357FCCD-A995-4576-B01F-234630154E96}" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="{2D2FBE3A-9A88-4308-A52E-7EF63CA7CF48}" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <!--
      Explorer cascade context menu for .pdf files (registry-only SubCommands
      pattern, Windows 7+). The parent verb declares MUIVerb + an EMPTY
      SubCommands value, which tells the shell to enumerate the sub-verbs from
      the `shell` subkey; the NN_ prefixes on the sub-verb keys control their
      order. Each command runs the installed app with `-\-tool <action>` — the
      action names MUST stay identical to TOOL_INTENT_ACTIONS in
      frontend/editor/src-tauri/src/launch_intent.rs and TOOL_INTENT_ACTIONS
      in frontend/editor/src/desktop/services/toolIntentService.ts.
      Notes:
      - `[!Path]` is the runtime-formatted path of the main executable's File
        entry in the bundler-generated main.wxs (the same reference its own
        deep-link/file-association commands use).
      - `SubCommands` uses Value="" deliberately; WiX v3 allows the empty
        string here (EmptyRule.CanBeEmpty) and writes an empty REG_SZ.
      - `MultiSelectModel=Player` lifts the default 15-item multi-select cap;
        Explorer still launches one process per selected file, which the app
        aggregates into a single batch (launch_intent.rs).
      - On Windows 11 these verbs appear under "Show more options" (the legacy
        menu); top-level Win11 placement would need a packaged
        IExplorerCommand extension and is a documented follow-up.
      - Uninstall: the cascade root key is force-deleted, which takes the whole
        `shell\NN_*\command` tree with it, and each verb component *also*
        force-deletes its own `NN_*` key so no component depends on another
        component's removal. Both live strictly inside
        `…\SystemFileAssociations\.pdf\shell\RustlingPDF`, a node this product
        creates; the shared `…\.pdf\shell` parent is never marked.
      - The verb key name and the MUIVerb title are the literal string
        "RustlingPDF". They used to be spelled `{{product_name}}` on the
        assumption that the bundler templated this file. It does not (see the
        note in the cleanup policy above), and MSI's Formatted parser leaves a
        `{…}` run containing no `[property]` substitution unchanged, so v3.1.0
        shipped a cascade menu whose key AND whose user-visible label were the
        raw token. The v3.1.0 leftovers are cleaned up below.
    -->
    <DirectoryRef Id="TARGETDIR">
      <Component Id="PdfContextMenuRootComponent" Guid="*">
        <!--
          Remove the v3.1.0-and-earlier cascade tree, whose root key was named
          with the unrendered Handlebars token. Action="removeOnInstall" emits a
          RemoveRegistry row with Name="-": "the key is to be deleted, if
          present, with all of its values and subkeys, when the component is
          installed" (MSI RemoveRegistry table). It is processed by
          RemoveRegistryValues (sequence 2600), i.e. after
          RemoveExistingProducts has uninstalled the old package and well before
          WriteRegistryValues (5000) writes the new keys — so an upgraded
          machine ends up with exactly one cascade menu, not a stale one beside
          a correct one. On a machine that never had v3.1.0 the row is a no-op.

          Not conditioned on WIX_UPGRADE_DETECTED on purpose: v3.1.0 could also
          have been *uninstalled* (which, before this change, left the same
          skeleton behind) and then this version installed fresh. The scope is
          one literal key path that only a bundler-templating bug can produce;
          the residual risk is a different Tauri application shipping this exact
          fragment bug and colliding on the same key, which is recorded in
          rust/contracts/desktop-windows-installer.md.

          The token is reproduced here verbatim on purpose, and this does not
          depend on knowing what MSI's Formatted parser makes of it: the
          RemoveRegistry Key column is the same RegPath/Formatted type as the
          Registry Key column v3.1.0 wrote through, fed the identical source
          string, so it resolves to whatever v3.1.0 actually created.
        -->
        <RemoveRegistryKey Id="RemoveLegacyUnrenderedCascadeKey" Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\{{product_name}}" Action="removeOnInstall" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\RustlingPDF" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="MUIVerb" Value="RustlingPDF" KeyPath="yes" />
          <RegistryValue Type="string" Name="SubCommands" Value="" />
          <RegistryValue Type="string" Name="Icon" Value="&quot;[!Path]&quot;,0" />
        </RegistryKey>
      </Component>
      <Component Id="PdfContextMenuOpenComponent" Guid="*">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\RustlingPDF\shell\01_open" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="MUIVerb" Value="Open" KeyPath="yes" />
          <RegistryValue Type="string" Name="MultiSelectModel" Value="Player" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\RustlingPDF\shell\01_open\command">
          <RegistryValue Type="string" Value="&quot;[!Path]&quot; --tool open &quot;%1&quot;" />
        </RegistryKey>
      </Component>
      <Component Id="PdfContextMenuMergeComponent" Guid="*">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\RustlingPDF\shell\02_merge" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="MUIVerb" Value="Merge" KeyPath="yes" />
          <RegistryValue Type="string" Name="MultiSelectModel" Value="Player" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\RustlingPDF\shell\02_merge\command">
          <RegistryValue Type="string" Value="&quot;[!Path]&quot; --tool merge &quot;%1&quot;" />
        </RegistryKey>
      </Component>
      <Component Id="PdfContextMenuCompressComponent" Guid="*">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\RustlingPDF\shell\03_compress" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="MUIVerb" Value="Compress" KeyPath="yes" />
          <RegistryValue Type="string" Name="MultiSelectModel" Value="Player" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\RustlingPDF\shell\03_compress\command">
          <RegistryValue Type="string" Value="&quot;[!Path]&quot; --tool compress &quot;%1&quot;" />
        </RegistryKey>
      </Component>
      <Component Id="PdfContextMenuConvertComponent" Guid="*">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\RustlingPDF\shell\04_convert" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="MUIVerb" Value="Convert" KeyPath="yes" />
          <RegistryValue Type="string" Name="MultiSelectModel" Value="Player" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.pdf\shell\RustlingPDF\shell\04_convert\command">
          <RegistryValue Type="string" Value="&quot;[!Path]&quot; --tool convert &quot;%1&quot;" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="ProvisioningComponentGroup">
      <ComponentRef Id="ProvisionerBinaryComponent" />
      <ComponentRef Id="ThumbnailHandlerDllComponent" />
      <ComponentRef Id="ThumbnailHandlerClsidComponent" />
      <ComponentRef Id="ThumbnailHandlerShellexComponent" />
      <ComponentRef Id="PdfContextMenuRootComponent" />
      <ComponentRef Id="PdfContextMenuOpenComponent" />
      <ComponentRef Id="PdfContextMenuMergeComponent" />
      <ComponentRef Id="PdfContextMenuCompressComponent" />
      <ComponentRef Id="PdfContextMenuConvertComponent" />
    </ComponentGroup>

    <CustomAction
      Id="WriteProvisioningFilePerUser"
      FileKey="ProvisionerExe"
      Execute="deferred"
      Impersonate="yes"
      Return="check"
      ExeCommand="[WriteProvisioningFilePerUser]"
    />

    <CustomAction
      Id="WriteProvisioningFileAllUsers"
      FileKey="ProvisionerExe"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      ExeCommand="[WriteProvisioningFileAllUsers]"
    />

    <CustomAction
      Id="SetWriteProvisioningFilePerUser"
      Property="WriteProvisioningFilePerUser"
      Value="--output &quot;[AppDataFolder]Stirling-PDF\stirling-provisioning.json&quot; --url &quot;[STIRLING_SERVER_URL]&quot; --lock &quot;[STIRLING_LOCK_CONNECTION]&quot; --login-agreement &quot;[STIRLING_LOGIN_AGREEMENT]&quot; --update-mode &quot;[STIRLING_UPDATE_MODE]&quot;"
    />

    <CustomAction
      Id="SetWriteProvisioningFileAllUsers"
      Property="WriteProvisioningFileAllUsers"
      Value="--output &quot;[CommonAppDataFolder]Stirling-PDF\stirling-provisioning.json&quot; --url &quot;[STIRLING_SERVER_URL]&quot; --lock &quot;[STIRLING_LOCK_CONNECTION]&quot; --login-agreement &quot;[STIRLING_LOGIN_AGREEMENT]&quot; --update-mode &quot;[STIRLING_UPDATE_MODE]&quot;"
    />

    <!--
      Uninstall counterparts. stirling-provisioning.json is written by a
      CustomAction, so MSI never learned about the file and cannot remove it on
      its own. The provisioner's removal mode — spelled `-\-remove`, because an
      XML comment cannot contain a literal double hyphen; same convention as
      `-\-tool` above — deletes exactly that one file (it refuses any other file
      name) and never touches the directory around it, which holds the user's
      settings.yml / custom_settings.yml / logs.

      Return="ignore": leftover administrative config must never be able to
      block or roll back an uninstall. A failure is recorded in the MSI log; the
      Windows lifecycle check asserts the file is actually gone.

      Known limitation: these are deferred, not commit, actions, and no rollback
      counterpart is authored. An uninstall that fails after this point and
      rolls back leaves the product installed but the provisioning file gone,
      until MDM re-pushes it. A commit action would avoid that but cannot be
      used: by InstallFinalize, RemoveFiles has already deleted the executable
      it would have to run.
    -->
    <CustomAction
      Id="RemoveProvisioningFilePerUser"
      FileKey="ProvisionerExe"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
      ExeCommand="[RemoveProvisioningFilePerUser]"
    />

    <CustomAction
      Id="RemoveProvisioningFileAllUsers"
      FileKey="ProvisionerExe"
      Execute="deferred"
      Impersonate="no"
      Return="ignore"
      ExeCommand="[RemoveProvisioningFileAllUsers]"
    />

    <CustomAction
      Id="SetRemoveProvisioningFilePerUser"
      Property="RemoveProvisioningFilePerUser"
      Value="--remove --output &quot;[AppDataFolder]Stirling-PDF\stirling-provisioning.json&quot;"
    />

    <CustomAction
      Id="SetRemoveProvisioningFileAllUsers"
      Property="RemoveProvisioningFileAllUsers"
      Value="--remove --output &quot;[CommonAppDataFolder]Stirling-PDF\stirling-provisioning.json&quot;"
    />

    <!--
      Run the provisioner when ANY of STIRLING_SERVER_URL, STIRLING_LOGIN_AGREEMENT, or
      STIRLING_UPDATE_MODE is set. The provisioner is a no-op if all values end up empty,
      so passing none is safe.

      The removal actions are scheduled after RemoveShortcuts (3200) and so run
      well before RemoveFiles (3500) deletes stirling-provision.exe out of
      INSTALLDIR — a FileKey CustomAction cannot run once its own file is gone.

      Their condition is REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE, matching the
      idiom main.wxs already uses for RemoveShortcuts and DeleteUpdateTask.
      NOT UPGRADINGPRODUCTCODE is load-bearing, not decoration: MajorUpgrade is
      scheduled afterInstallInitialize, so every update — including the tauri
      updater's own `installMode: "passive"` msiexec run, which passes none of
      the STIRLING_* properties — fully uninstalls the old product before
      installing the new one. Without the guard, an unattended app update would
      delete the administrator's provisioning file and nothing would put it
      back.
    -->
    <InstallExecuteSequence>
      <Custom Action="SetWriteProvisioningFilePerUser" After="InstallFiles">(STIRLING_SERVER_URL &lt;&gt; &quot;&quot; OR STIRLING_LOGIN_AGREEMENT &lt;&gt; &quot;&quot; OR STIRLING_UPDATE_MODE &lt;&gt; &quot;&quot;) AND (NOT ALLUSERS OR ALLUSERS=0)</Custom>
      <Custom Action="WriteProvisioningFilePerUser" After="SetWriteProvisioningFilePerUser">(STIRLING_SERVER_URL &lt;&gt; &quot;&quot; OR STIRLING_LOGIN_AGREEMENT &lt;&gt; &quot;&quot; OR STIRLING_UPDATE_MODE &lt;&gt; &quot;&quot;) AND (NOT ALLUSERS OR ALLUSERS=0)</Custom>
      <Custom Action="SetWriteProvisioningFileAllUsers" After="InstallFiles">(STIRLING_SERVER_URL &lt;&gt; &quot;&quot; OR STIRLING_LOGIN_AGREEMENT &lt;&gt; &quot;&quot; OR STIRLING_UPDATE_MODE &lt;&gt; &quot;&quot;) AND (ALLUSERS=1 OR ALLUSERS=2)</Custom>
      <Custom Action="WriteProvisioningFileAllUsers" After="SetWriteProvisioningFileAllUsers">(STIRLING_SERVER_URL &lt;&gt; &quot;&quot; OR STIRLING_LOGIN_AGREEMENT &lt;&gt; &quot;&quot; OR STIRLING_UPDATE_MODE &lt;&gt; &quot;&quot;) AND (ALLUSERS=1 OR ALLUSERS=2)</Custom>
      <Custom Action="SetRemoveProvisioningFilePerUser" After="RemoveShortcuts">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND (NOT ALLUSERS OR ALLUSERS=0)</Custom>
      <Custom Action="RemoveProvisioningFilePerUser" After="SetRemoveProvisioningFilePerUser">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND (NOT ALLUSERS OR ALLUSERS=0)</Custom>
      <Custom Action="SetRemoveProvisioningFileAllUsers" After="RemoveShortcuts">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND (ALLUSERS=1 OR ALLUSERS=2)</Custom>
      <Custom Action="RemoveProvisioningFileAllUsers" After="SetRemoveProvisioningFileAllUsers">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND (ALLUSERS=1 OR ALLUSERS=2)</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
